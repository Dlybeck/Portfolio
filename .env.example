# Auto-generated env example for local CODING_SERVICE configuration
##
## CODING_SERVICE: selects which local service to run.
## - openhands: OpenHands environment (default)
## Legacy OpenCode environment removed
## See also PORT, DEBUG, API_BASE_URL, etc.

CODING_SERVICE=openhands

## Common configuration placeholders (do not commit secrets)
## Port that the service runs on
PORT=3000

## Debug flag
DEBUG=true

## Base URL for APIs or services
API_BASE_URL=http://localhost:3000

## Optional TLS/SSL paths (leave empty if not using TLS)
SSL_CERT_PATH=
SSL_KEY_PATH=

## Logging level
LOG_LEVEL=info

## Portfolio Theme Engine. Keep all three false for the legacy canonical view.
## Enable THEMES_ENABLED for random complete-world selection on unpinned loads.
## THEME_SELECTOR_ENABLED controls only the navbar development selector.
## THEME_LAB_ENABLED is the local shortcut that enables both engine and selector.
THEMES_ENABLED=false
THEME_SELECTOR_ENABLED=false
THEME_LAB_ENABLED=false

## Example for additional features
## WEBHOOK_URL=
## DATABASE_URL=
